{
 "operations": [
  {
   "id": "endstone-textpacket-message-category",
   "file": "packets/TextPacket.json",
   "pointer": "/fields",
   "pre_patch_sha256": "sha256:02db93676b8f667db4e63453ff316b8515b62242df4c5cbe910c069f0eb5da63",
   "replace": [
    {
     "name": "Localize?",
     "type": "bool"
    },
    {
     "name": "Message Category",
     "type": "uint8"
    },
    {
     "name": "Body",
     "type": {
      "switch": {
       "name": "Message Type",
       "type": "uint8",
       "enum": "TextPacketType"
      },
      "cases": [
       "TextPacketPayload::MessageOnly",
       "TextPacketPayload::AuthorAndMessage",
       "TextPacketPayload::MessageAndParams"
      ]
     }
    },
    {
     "name": "Sender's XUID",
     "type": "string",
     "constraints": {
      "max_length": 64
     }
    },
    {
     "name": "Platform Id",
     "type": "string",
     "constraints": {
      "max_length": 256
     }
    },
    {
     "name": "Filtered Message",
     "type": "string",
     "constraints": {
      "max_length": 65536
     },
     "optional": true
    }
   ],
   "why": "Both pinned sources omit the message category byte that the 1.26.40 wire carries between Localize and the message-type tag; production implementations read and write it.",
   "evidence": [
    {
     "locator": "https://github.com/HashimTheArab/gophertunnel/blob/1653b5407e9b4ce9e8fa272f7713688d42973e3f/minecraft/protocol/packet/text.go",
     "summary": "Live 1.26.40 fork writes bool, category byte derived from TextType, type byte, then body; chat traffic proxies through it in production."
    },
    {
     "locator": "https://github.com/CloudburstMC/Protocol/blob/develop/bedrock-codec/src/main/java/org/cloudburstmc/protocol/bedrock/codec/v924/serializer/TextSerializer_v924.java",
     "summary": "Cloudburst's newest Text serializer writes the category byte (writeByte(0) MessageOnly) before the type ordinal."
    }
   ]
  }
 ]
}